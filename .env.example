# ============================================
# Real-Time Communication POC — Environment Variables
# ============================================
# Copy this file to .env and adjust values if needed.
#   cp .env.example .env

# --------------------------------------------
# MQTT Configuration
# --------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
TEMPERATURE_TOPIC=building/floor1/temperature

# --------------------------------------------
# Kafka Configuration
# --------------------------------------------
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=event-streaming-poc
LOGIN_TOPIC=user-events
